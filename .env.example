# Copy to .env (git-ignored). Local defaults below work with docker-compose.yml as is.

# Telegram collector: https://my.telegram.org -> API development tools (only the owner needs these)
TG_API_ID=37745379
TG_API_HASH=c6f1457cb3e18aa5b79a205e20e53a5c
TG_SESSION=collector

# MinIO (DVC remote and MLflow artifacts) and PostgreSQL
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
POSTGRES_USER=dzhynsa
POSTGRES_PASSWORD=dzhynsa

# DVC reads the MinIO keys from these
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345

# MLflow client on the host
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
